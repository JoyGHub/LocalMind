{
  "name": "localmind",
  "version": "0.0.1",
  "description": "A local web app for chatting with language models through Ollama.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/localmind/localmind.esm.js",
  "exports": {
    ".": {
      "import": "./dist/localmind/localmind.esm.js",
      "require": "./dist/localmind/localmind.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoyGHub/LocalMind.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "start:llm": "cd backend && python llm_api.py",
    "start:tts": "cd backend && python -m uvicorn tts_api:app --reload --port 8000",
    "dev": "concurrently -k -n \"LLM,TTS,UI\" -c \"blue,magenta,green\" \"npm run start:llm\" \"npm run start:tts\" \"npm start\"",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shoelace-style/shoelace": "^2.20.1",
    "@stencil/core": "^4.7.0",
    "@stencil/store": "^2.2.2",
    "@types/jest": "^29.5.6",
    "@types/node": "^16.18.126",
    "concurrently": "^10.0.3",
    "dexie": "^4.4.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "html2pdf.js": "^0.14.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jiti": "^2.6.1",
    "marked": "^18.0.6",
    "mathjs": "^15.2.0",
    "puppeteer": "^24.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.27",
    "maplibre-gl": "^5.24.0",
    "nanoid": "^6.0.0",
    "pdfjs-dist": "^3.11.174"
  }
}
